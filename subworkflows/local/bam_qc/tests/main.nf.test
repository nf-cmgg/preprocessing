    test("bam QC - full - roi - seqcap") {

        when {
            workflow {
                """
                // [meta, bam, bai, roi, fasta, fai, gtf]
                input[0] = Channel.of([
                    [ id:'test', single_end:false, qc_mode:'full', tag:'seqcap' ],
