/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/preprocessing/'
}

includeConfig "../tests/config/igenomes_test.config"

aws {
    client {
        endpoint          = 'https://s3.ugent.be'
        s3PathStyleAccess = true
    }
}

process {
    resourceLimits = [
        cpus: 2,
        memory: 6.GB,
        time: 6.h,
    ]
}
