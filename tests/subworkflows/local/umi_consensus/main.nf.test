nextflow_workflow {

    name "Test Workflow UMI_CONSENSUS_KAPA"
    script "subworkflows/local/umi_consensus/main.nf"
    workflow "UMI_CONSENSUS_KAPA"

    tag "subworkflows"
    tag "subworkflows/local"
    tag "subworkflows/local/umi_consensus"

    test("umi consensus workflow - stub") {
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [
                        id: "test_umi",
                        samplename: "test_umi",
                        umi_min_reads: 2,
                        aligner: "bwamem"
                    ],
                    file('/etc/hosts', checkIfExists:true),
                    file('/etc/group', checkIfExists:true),
                    "bwamem",
                    file("s3://test-data/genomics/homo_sapiens/genome/bwa/", checkIfExists:true),
                    file("s3://test-data/genomics/homo_sapiens/genome/seq/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set_chr21.fna", checkIfExists:true)
                ])
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.bam_bai
            assert workflow.out.family_sizes
        }
    }
}
