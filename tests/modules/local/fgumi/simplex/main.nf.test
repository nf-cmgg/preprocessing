nextflow_process {

    name "Test Process FGUMI_SIMPLEX"
    script "modules/local/fgumi/simplex/main.nf"
    process "FGUMI_SIMPLEX"

    tag "modules"
    tag "modules/local"
    tag "modules/local/fgumi"
    tag "modules/local/fgumi/simplex"

    test("test - stub") {
        // Stub-mode contract test: verifies simplex BAM and consensus metrics.
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: "test"],
                    file("https://github.com/nf-cmgg/test-datasets/raw/main/data/genomics/homo_sapiens/illumina/bam/grouped.bam", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
