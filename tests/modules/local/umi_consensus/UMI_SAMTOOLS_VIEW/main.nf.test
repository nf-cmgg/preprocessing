nextflow_process {

    name "Test Process UMI_SAMTOOLS_VIEW"
    script "modules/local/umi_consensus/main.nf"
    process "UMI_SAMTOOLS_VIEW"

    tag "modules"
    tag "modules/local"
    tag "modules/local/umi_consensus"

    test("stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [[id: "test", samplename: "test"], file("https://github.com/nf-cmgg/test-datasets/raw/preprocessing/data/genomics/homo_sapiens/illumina/fastq/sample1_R1.fastq.gz", checkIfExists:true), file("/etc/hosts", checkIfExists:true)]
                input[1] = [[id: "test", samplename: "test"], file("https://github.com/nf-cmgg/test-datasets/raw/preprocessing/data/genomics/homo_sapiens/genome/seq/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set_chr21.fna", checkIfExists:true), file("https://github.com/nf-cmgg/test-datasets/raw/preprocessing/data/genomics/homo_sapiens/genome/seq/GCA_000001405.15_GRCh38_full_plus_hs38d1_analysis_set_chr21.fna.fai", checkIfExists:true)]
                input[2] = file("/dev/null", checkIfExists:true)
                input[3] = []
                """
            }
        }

        then {
            assert process.success
            assert process.out.versions_samtools
        }
    }
}
