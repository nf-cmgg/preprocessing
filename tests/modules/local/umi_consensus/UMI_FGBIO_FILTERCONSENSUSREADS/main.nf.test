nextflow_process {
    name "Test Process UMI_FGBIO_FILTERCONSENSUSREADS"
    script "modules/local/umi_consensus/main.nf"
    process "UMI_FGBIO_FILTERCONSENSUSREADS"

    tag "modules"
    tag "modules/local"
    tag "modules/local/umi_consensus"

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [[id: "test", samplename: "test", umi_min_reads: 2], file("https://github.com/nf-cmgg/test-datasets/raw/preprocessing/data/genomics/homo_sapiens/illumina/fastq/sample1_R1.fastq.gz", checkIfExists:true)]
                input[1] = [[id: "ref"], file("https://github.com/nf-cmgg/test-datasets/raw/preprocessing/data/genomics/homo_sapiens/illumina/fastq/sample1_R2.fastq.gz", checkIfExists:true)]
                input[2] = 2
                input[3] = 45
                input[4] = 0.2
                """
            }
        }
        then {
            assert process.success
            assert process.out.bam
        }
    }
}
