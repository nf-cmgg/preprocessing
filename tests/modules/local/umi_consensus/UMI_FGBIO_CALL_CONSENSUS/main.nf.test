nextflow_process {
    name "Test Process UMI_FGBIO_CALL_CONSENSUS"
    script "modules/local/umi_consensus/main.nf"
    process "UMI_FGBIO_CALL_CONSENSUS"

    tag "modules"
    tag "modules/local"
    tag "modules/local/umi_consensus"

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [[id: "test", samplename: "test", umi_min_reads: 2], file("https://github.com/nf-cmgg/test-datasets/raw/preprocessing/data/genomics/homo_sapiens/illumina/fastq/sample1_R1.fastq.gz", checkIfExists:true)]
                """
            }
        }
        then {
            assert process.success
            assert process.out.raw_unmapped
        }
    }
}
