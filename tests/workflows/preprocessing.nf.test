            }
        }

        then {
            assert workflow.success
            assert snapshot(
                sanitizeOutput(workflow.out, unstableKeys:[
                    "multiqc_main_report",
                    "multiqc_main_data",
                    "multiqc_main_plots",
                    "multiqc_library_report",
                    "multiqc_library_data",
                    "multiqc_library_plots",
                    "md5sums",
                    "fastp_html",
                    "crams",
                    "picard_wgsmetrics",
                    "picard_multiplemetrics_pdf",
                    "picard_multiplemetrics",
                    "picard_hsmetrics",
                    "samtools_flagstat",
                    "samtools_coverage",
                    "samtools_stats"
                ])
            ).match()
        }
    }
}
